<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.SopsMapper">

    <select id="selectById" resultType="com.example.entity.Sops">
        select * from `sops` where id = #{id}
    </select>

    <select id="selectAll" resultType="com.example.entity.Sops">
        select * from `sops`
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%')
                  OR content_text LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY sort_order ASC, updated_at DESC
    </select>

    <insert id="insert" parameterType="com.example.entity.Sops" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into `sops`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">title,</if>
            <if test="contentHtml != null">content_html,</if>
            <if test="contentText != null">content_text,</if>
            <if test="sortOrder != null">sort_order,</if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">#{title},</if>
            <if test="contentHtml != null">#{contentHtml},</if>
            <if test="contentText != null">#{contentText},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.Sops">
        update `sops`
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="contentHtml != null">content_html = #{contentHtml},</if>
            <if test="contentText != null">content_text = #{contentText},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from `sops` where id = #{id}
    </delete>
</mapper>
